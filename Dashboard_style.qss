

QMainWindow {
    background-color: #ebf1fa;
}

QLabel {
    color: #303030;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 15px;
}

#sidebar_layout {
    background-color: #b6c9e0;
    color: #fcfeff;
}

#dashboard_btn {
    background-color: transparent;
}

#transaction_btn {
    background-color: transparent;
}

#about_btn {
    background-color: transparent;
}

#exit_btn {
    background-color: transparent;
}

#header {
    font-size: 29px;
    font-weight: bold;
    color: #3c5670;
    text-transform: uppercase;
    }

#addApptBtn {

    border: none;
    border-radius: 8px;
    padding: 8px;
    font-weight: bold;
    background-color: #6491bf;
    text-align: center;
    color: #fcfeff;
    margin-right: 20px;
}

#inQueue_text {
    font-weight: bold;
    padding-left: 20px;
}

#total_text {

    padding-left: 20px;
}

#customers_layout {
    background-color: #FFFFFF;
    border-radius: 15px;
    margin: 20px;
    margin-top: 5px;
}

#customer_name {
    padding-right: 10px;
    background-color: transparent;
    font-size: 18px;
}

#statusDot {
    padding-left: 50px;
}

#cardLine { color: #c8cfd8; }

#details_layout {
    background-color: #FFFFFF;
}

#details_placeholder {
    color: #939393;
    font-size: 15px;
}